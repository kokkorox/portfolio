<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PVR Raja | Composer & Music Director</title>
<meta name="description" content="Official portfolio of PVR Raja, film composer and music director.">
<link rel="stylesheet" href="style.css">
</head>
<body>
<header class="nav">
  <a href="#home" class="logo" id="logoName">PVR Raja</a>
  <nav>
    <a href="#about">About</a><a href="#films">Films</a><a href="#music">Music</a><a href="#gallery">Gallery</a><a href="#contact">Contact</a>
  </nav>
</header>

<section id="home" class="hero">
  <img src="images/profile.jpg" alt="Profile photo" class="hero-img" onerror="this.style.display='none'">
  <div class="hero-text">
    <p class="tag">Composer • Music Director</p>
    <h1 id="heroName">PVR Raja</h1>
    <p id="heroLine">Crafting the sound of cinema.</p>
    <a href="#music" class="btn">Listen Now</a>
  </div>
</section>

<section id="about"><h2>About</h2>
  <p id="aboutText">Write your biography here.</p>
  <div class="stats" id="stats"></div>
</section>

<section id="films"><h2>Filmography</h2><div class="grid" id="filmGrid"></div></section>
<section id="music"><h2>Music</h2><div class="grid" id="musicGrid"></div></section>
<section id="gallery"><h2>Gallery</h2><div class="gallery" id="galleryGrid"></div></section>

<section id="contact"><h2>Contact</h2>
  <p>For collaborations and bookings:</p>
  <p><a id="email" href="mailto:you@example.com">you@example.com</a></p>
  <div class="social" id="social"></div>
</section>

<footer>© <span id="year"></span> <span id="footName">PVR Raja</span>. All rights reserved.</footer>
<div class="lightbox" id="lightbox"><img alt=""></div>
<script src="script.js"></script>
</body>
</html>

// ====== EDIT ONLY THIS BLOCK ======
const DATA = {
  name: "PVR Raja",
  tagline: "Crafting the sound of cinema.",
  about: "Penumatsa Venkata Ramaraju known professionally as PVR Raja, is an Indian music composer, record producer, songwriter and guitarist who works in Telugu cinema. He is nicknamed "Short films Maestro" and "Ilaiyaraaja of Short films". He initially composed music for over 250 Short films and Independent films.",
  email: "you@example.com",
  stats: [["25+","Films"],["100+","Songs"],["10","Years"]],
  films: [
    {title:"MADHI", year:"2024", role:"Music Director", poster:"images/film1.jpg"},
    {title:"KUMBARA", year:"2023", role:"Composer", poster:"images/film2.jpg"}
  ],
  music: [
    {title:"Song Title", film:"MADHI", cover:"images/song1.jpg", link:"https://youtube.com"}
  ],
  gallery: ["images/g1.jpg","images/g2.jpg","images/g3.jpg"],
  social: [["YouTube","https://youtube.com"],["Instagram","https://instagram.com"],["Spotify","https://spotify.com"]]
};
// ==================================
const $ = id => document.getElementById(id);
document.title = DATA.name + " | Composer & Music Director";
["logoName","heroName","footName"].forEach(i => $(i).textContent = DATA.name);
$("heroLine").textContent = DATA.tagline;
$("aboutText").textContent = DATA.about;
$("email").textContent = DATA.email; $("email").href = "mailto:" + DATA.email;
$("year").textContent = new Date().getFullYear();
$("stats").innerHTML = DATA.stats.map(s => `<div class="stat"><b>${s[0]}</b>${s[1]}</div>`).join("");
$("filmGrid").innerHTML = DATA.films.map(f => `<div class="card"><img src="${f.poster}" alt="${f.title}" loading="lazy"><div><h3>${f.title}</h3><p>${f.year} • ${f.role}</p></div></div>`).join("");
$("musicGrid").innerHTML = DATA.music.map(m => `<div class="card"><img src="${m.cover}" alt="${m.title}" loading="lazy"><div><h3>${m.title}</h3><p>${m.film}</p><a href="${m.link}" target="_blank" rel="noopener">▶ Listen</a></div></div>`).join("");
$("galleryGrid").innerHTML = DATA.gallery.map(g => `<img src="${g}" alt="Gallery photo" loading="lazy">`).join("");
$("social").innerHTML = DATA.social.map(s => `<a href="${s[1]}" target="_blank" rel="noopener">${s[0]}</a>`).join("");
const lb = $("lightbox");
document.querySelectorAll(".gallery img").forEach(i => i.onclick = () => { lb.querySelector("img").src = i.src; lb.classList.add("on"); });
lb.onclick = () => lb.classList.remove("on");

:root{--bg:#0d0d10;--card:#17171c;--text:#eee;--muted:#a0a0aa;--gold:#d4a84b}
@media(prefers-color-scheme:light){:root{--bg:#f6f4ef;--card:#fff;--text:#1a1a1a;--muted:#666}}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
.nav{position:fixed;top:0;width:100%;display:flex;justify-content:space-between;align-items:center;padding:14px 5%;background:rgba(13,13,16,.85);backdrop-filter:blur(8px);z-index:10}
.nav a{color:#eee;text-decoration:none;margin-left:20px;font-size:.95rem}
.nav a:hover,.logo{color:var(--gold)}
.logo{font-weight:700;margin:0!important;font-size:1.1rem!important}
.hero{min-height:100vh;display:flex;align-items:center;gap:40px;padding:100px 8% 40px;background:radial-gradient(circle at 70% 30%,#2a2110,#0d0d10 70%);color:#eee;flex-wrap:wrap-reverse}
.hero-text{flex:1;min-width:280px}
.hero-img{width:min(380px,80vw);aspect-ratio:3/4;object-fit:cover;border-radius:16px;border:2px solid var(--gold)}
.tag{color:var(--gold);letter-spacing:3px;text-transform:uppercase;font-size:.85rem}
h1{font-size:clamp(2.4rem,6vw,4.5rem);line-height:1.1;margin:10px 0}
.btn{display:inline-block;margin-top:20px;padding:12px 28px;background:var(--gold);color:#111;border-radius:30px;text-decoration:none;font-weight:600}
section{padding:80px 8%;max-width:1200px;margin:auto}
h2{font-size:2rem;margin-bottom:24px;color:var(--gold)}
.stats{display:flex;gap:30px;flex-wrap:wrap;margin-top:28px}
.stat b{display:block;font-size:2rem;color:var(--gold)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:20px}
.card{background:var(--card);border-radius:12px;overflow:hidden;transition:.25s}
.card:hover{transform:translateY(-5px)}
.card img{width:100%;aspect-ratio:2/3;object-fit:cover;background:#2a2a30;display:block}
.card div{padding:14px}
.card h3{font-size:1.05rem}
.card p{color:var(--muted);font-size:.9rem}
.card a{color:var(--gold);font-size:.9rem;text-decoration:none}
.gallery{columns:3 220px;gap:14px}
.gallery img{width:100%;margin-bottom:14px;border-radius:10px;cursor:pointer}
.social a{color:var(--gold);margin-right:18px;text-decoration:none}
#contact a{color:var(--gold)}
footer{text-align:center;padding:30px;color:var(--muted);font-size:.85rem}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.9);display:none;align-items:center;justify-content:center;z-index:20}
.lightbox.on{display:flex}
.lightbox img{max-width:92%;max-height:90%;border-radius:8px}
